{
  "name": "mop-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "data": "tsx scripts/build-data.ts",
    "prebuild": "npm run data",
    "build": "next build",
    "postbuild": "npm run check:browsers",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:browsers": "node scripts/check-browser-support.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "ios_saf >= 15",
    "safari >= 15",
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "samsung >= 15"
  ]
}
